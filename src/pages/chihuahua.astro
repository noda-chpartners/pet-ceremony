---
import BreedPage from '../components/BreedPage.astro';
import chihuahuaImage from '../assets/images/lp-breed-chihuahua.png';
---

<BreedPage
  title="チワワの火葬・葬儀 13,200円〜｜相模原市の訪問ペット火葬｜ペットセレモニーファミリア"
  description="チワワの火葬は13,200円〜（税込・骨壺代込み）。相模原市を中心に24時間365日、ご自宅へお伺いする訪問ペット火葬・葬儀です。小さな身体に合わせた丁寧なお見送りを、Google口コミ評価4.9のファミリアがお手伝いします。"
  eyebrow="チワワの飼い主さまへ"
  heading="小さな身体に、<br />いちばん大きな愛情を。"
  lead="いつも腕の中にいた、小さな家族。チワワちゃんの華奢な身体に合わせて、火葬の温度や時間まで細やかに調整し、きれいなお骨を残せるよう丁寧にお見送りします。"
  image={chihuahuaImage}
  imageAlt="クッションの上に座るチワワ"
  priceRowIndexes={[2]}
  priceNote="チワワちゃん（ロングコートチワワを含む）は、目安5kg未満の料金区分でのご案内です。"
  points={[
    {
      title: '小さな身体に合わせた火葬管理',
      text: 'チワワちゃんのような小さな身体は、火力の調整がお骨の残り方を大きく左右します。経験を積んだスタッフが温度と時間を細やかに管理し、お骨上げまで丁寧にお手伝いします。',
    },
    {
      title: '住み慣れたお家からのお見送り',
      text: '甘えん坊で寂しがり屋の子が多いチワワちゃん。最期は知らない場所ではなく、いつも過ごしたお家の前から旅立たせてあげられます。',
    },
    {
      title: '想いを形に残すファミリアプラン',
      text: '小さな肉球の形を粘土に残す足跡スタンプや、やわらかなおくるみなど、「ちゃんとしてあげたい」に応えるお見送りの品をご用意しています。',
    },
  ]}
/>
