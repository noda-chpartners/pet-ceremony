---
import BreedPage from '../components/BreedPage.astro';
import dachshundImage from '../assets/images/lp-breed-dachshund.png';
---

<BreedPage
  title="ミニチュアダックスの火葬・葬儀 13,200円〜｜相模原市の訪問ペット火葬｜ペットセレモニーファミリア"
  description="ミニチュアダックス・カニンヘンダックスの火葬は13,200円〜（税込・骨壺代込み）。相模原市を中心に24時間365日、ご自宅へお伺いする訪問ペット火葬・葬儀。Google口コミ評価4.9のファミリアが丁寧にお手伝いします。"
  eyebrow="ダックスフンドの飼い主さまへ"
  heading="長いお散歩の思い出に、<br />ありがとうを込めて。"
  lead="胴の長い愛らしい姿で、家族をいつも笑顔にしてくれたダックスちゃん。カニンヘン・ミニチュアそれぞれの体格に合わせた料金区分で、丁寧にお見送りします。"
  image={dachshundImage}
  imageAlt="ブランケットの上でくつろぐミニチュアダックスフンド"
  priceRowIndexes={[2, 3]}
  priceNote="カニンヘンダックスちゃんは目安5kg未満、ミニチュアダックスちゃんは目安8kg未満の料金区分でのご案内です。"
  points={[
    {
      title: '体格に合わせた無理のないご案内',
      text: '同じダックスでもカニンヘンとミニチュアでは体格が異なります。体重を基準にした明朗な料金区分で、迷わずお選びいただけます。',
    },
    {
      title: '腰に負担をかけない、やさしいお預かり',
      text: '腰の弱い子が多いダックスちゃん。お預かりからご安置まで、身体に負担をかけないようやさしく丁寧にお運びします。',
    },
    {
      title: 'ご家族の手で行うお骨上げ',
      text: '立会火葬・ファミリアプランでは、ご家族の手でお骨上げをしていただけます。最後まで「家族の一員」として見送ってあげられます。',
    },
  ]}
/>
