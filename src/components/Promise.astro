---
import { Image } from 'astro:assets';
import memorialImage from '../assets/images/memorial-at-home.webp';
import associationImage from '../assets/images/vet-association.webp';
import Icon from './Icon.astro';

const points = [
  { icon: 'clock' as const, title: '24時間365日', text: '深夜・早朝を問わず、いつでもご相談を承ります。' },
  { icon: 'heart' as const, title: '一体ずつ丁寧に', text: '小さな動物から大型犬まで、心を込めてお預かりします。' },
  { icon: 'home' as const, title: 'ご自宅でお見送り', text: '移動の負担なく、慣れ親しんだ場所でお別れができます。' },
];
---

<section class="promise section" id="promise">
  <div class="container promise__inner">
    <div class="promise__visual" data-reveal>
      <div class="promise__portrait promise__portrait--memorial">
        <Image class="promise__image" src={memorialImage} alt="写真と花を添えた自宅供養の様子" widths={[480, 720]} sizes="(max-width: 767px) 88vw, 540px" />
      </div>
      <div class="promise__portrait promise__portrait--association">
        <Image class="promise__image" src={associationImage} alt="神奈川県獣医師会報への掲載実績" widths={[360, 560]} sizes="(max-width: 767px) 52vw, 300px" />
      </div>
      <p class="promise__visual-note">地域に根ざして<br />一つひとつ丁寧に</p>
    </div>

    <div class="promise__copy" data-reveal>
      <p class="section-kicker">Our Promise</p>
      <h2 class="section-heading">いつも、そばに。</h2>
      <p class="promise__lead">お別れのとき、何から始めればよいか分からないのは当然のことです。ペットセレモニーファミリアは、ご家族のお気持ちを急かすことなく、一つひとつ丁寧にご案内します。</p>
      <div class="promise__points">
        {points.map((point) => (
          <article class="promise__point">
            <span class="promise__point-icon-wrap"><Icon name={point.icon} class="promise__point-icon" /></span>
            <div class="promise__point-copy">
              <h3 class="promise__point-title">{point.title}</h3>
              <p class="promise__point-text">{point.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
