---
import Icon from './Icon.astro';
import { site } from '../data/site';

const steps = [
  {
    number: '01',
    title: 'ご相談・ご予約',
    text: 'お電話・LINE・メールでご連絡ください。安置の方法から日程・プランまで、担当スタッフが順番にご案内しますので、何も決まっていなくても大丈夫です。',
  },
  {
    number: '02',
    title: 'ご自宅へお伺い',
    text: 'ご予約の日時に、無煙無臭の専用火葬車でご自宅へお伺いします。自家発電装置を備えており、騒音を抑えたご近所に配慮した運用です。',
  },
  {
    number: '03',
    title: 'お別れ・火葬',
    text: 'プランの内容を丁寧にご説明したうえで、火葬を執り行います。立会火葬・ファミリアプランでは、ロウソク・お線香・お花を供えたセレモニーで、火を入れる瞬間までお見送りいただけます。',
  },
  {
    number: '04',
    title: 'お骨上げ・ご返骨',
    text: 'ご返骨のあるプランでは、ご家族の手でお骨上げをしていただき、骨壺に納めてお返しします。ご返骨のないプランは、供養塔への埋葬または海洋散骨で心を込めてご供養します。',
  },
];

const areas = [
  { name: '神奈川県', detail: '相模原市・町田市周辺、川崎市、横浜市、厚木市、大和市、海老名市、座間市 ほか' },
  { name: '東京都', detail: '町田市、八王子市、多摩市、日野市、立川市、府中市、調布市 ほか' },
  { name: '山梨県', detail: '上野原市、都留市、道志村、山中湖村 ほか' },
];
---

<section class="flow section" id="flow">
  <div class="container">
    <div class="sec-head" data-reveal>
      <span class="sec-en">Flow</span>
      <h2 class="sec-title">お見送りの流れ</h2>
      <p class="sec-lead">
        慣れないことばかりでも、ご安心ください。ご相談からお見送り、ご供養まで、担当スタッフがすべて丁寧にお手伝いします。
      </p>
      <hr class="sec-rule" />
    </div>

    <ol class="flow__steps">
      {steps.map((step) => (
        <li class="flow-step" data-reveal>
          <span class="flow-step__number">{step.number}</span>
          <h3 class="flow-step__title">{step.title}</h3>
          <p class="flow-step__text">{step.text}</p>
        </li>
      ))}
    </ol>

    <div class="flow__info" data-reveal>
      <div class="flow__payment">
        <h3 class="flow__info-title">お支払いについて</h3>
        <p class="flow__info-text">
          当日のお別れの後に、その場でお支払いいただけます。現金のほか、クレジットカードもご利用可能です（一括払いのみ）。
        </p>
      </div>
      <div class="flow__area">
        <h3 class="flow__info-title"><Icon name="map" class="flow__info-icon" />訪問対応エリア</h3>
        <p class="flow__info-text">相模原駅を起点に半径30km圏内は出張費0円で対応しています。</p>
        <dl class="flow__area-list">
          {areas.map((area) => (
            <div class="flow__area-row">
              <dt class="flow__area-name">{area.name}</dt>
              <dd class="flow__area-detail">{area.detail}</dd>
            </div>
          ))}
        </dl>
        <p class="flow__area-note">※30kmを超える場合は10kmごとに往復4,400円（税込）の出張費を頂戴いたします。エリア外の方もまずはご相談ください。</p>
      </div>
    </div>

    <div class="flow__support" data-reveal>
      <p class="flow__support-copy">深夜・早朝のお迎えも承ります。まずは落ち着いて、お電話ください。</p>
      <a class="flow__support-phone" href={site.freedialTel}>
        <Icon name="phone" class="flow__support-icon" />
        <span class="flow__support-inner">
          <span class="flow__support-note">通話無料・24時間365日受付</span>
          <strong class="flow__support-number">{site.freedial}</strong>
        </span>
      </a>
    </div>
  </div>
</section>
