---
interface Props {
  tone: 'paper-white' | 'green-cream' | 'cream-paper' | 'paper-white-reverse';
}

const { tone } = Astro.props;
---

<div class:list={['soft-divider', `soft-divider--${tone}`]} aria-hidden="true">
  <span class="soft-divider__hill soft-divider__hill--large"></span>
  <span class="soft-divider__hill soft-divider__hill--small"></span>
</div>
