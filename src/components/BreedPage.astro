---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Plans from './Plans.astro';
import Flow from './Flow.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import Icon from './Icon.astro';
import { priceTable, planColumns, yen } from '../data/pricing';
import { site } from '../data/site';
import '../styles/home.scss';

interface Point {
  title: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  lead: string;
  image: ImageMetadata;
  imageAlt: string;
  /** priceTable の該当行インデックス */
  priceRowIndexes: number[];
  priceNote: string;
  points: Point[];
}

const { title, description, eyebrow, heading, lead, image, imageAlt, priceRowIndexes, priceNote, points } = Astro.props;
const rows = priceRowIndexes.map((index) => priceTable[index]);
const minPrice = Math.min(...rows.map((row) => row.joint ?? row.private));
---

<BaseLayout title={title} description={description}>
  <Header />
  <main class="main-content">
    <section class="breed-hero" id="top">
      <div class="container breed-hero__inner">
        <div class="breed-hero__copy" data-hero-copy>
          <p class="breed-hero__eyebrow"><span class="breed-hero__eyebrow-line"></span>{eyebrow}</p>
          <h1 class="breed-hero__title" set:html={heading} />
          <p class="breed-hero__lead" set:html={lead} />
          <p class="breed-hero__price">
            <span class="breed-hero__price-label">火葬料金</span>
            <strong class="breed-hero__price-number">{minPrice.toLocaleString('ja-JP')}</strong>
            <span class="breed-hero__price-unit">円（税込）〜</span>
          </p>
          <div class="breed-hero__actions">
            <a class="breed-hero__phone" href={site.freedialTel}>
              <Icon name="phone" class="breed-hero__phone-icon" />
              <span class="breed-hero__phone-copy">
                <span class="breed-hero__phone-note">通話無料・24時間受付</span>
                <strong class="breed-hero__phone-number">{site.freedial}</strong>
              </span>
            </a>
            <a class="btn btn--gold breed-hero__cta" href={site.lineUrl} target="_blank" rel="noopener noreferrer">
              <Icon name="line" class="btn__icon" />LINEで相談
            </a>
          </div>
        </div>
        <div class="breed-hero__visual" data-hero-visual>
          <div class="breed-hero__frame">
            <Image class="breed-hero__image" src={image} alt={imageAlt} widths={[520, 780, 1100]} sizes="(max-width: 900px) 100vw, 46vw" loading="eager" />
          </div>
        </div>
      </div>
    </section>

    <section class="breed-price section" id="price">
      <div class="container">
        <div class="sec-head" data-reveal>
          <span class="sec-en">Price</span>
          <h2 class="sec-title">料金のご案内</h2>
          <p class="sec-lead">{priceNote} すべて税込・骨壺と骨袋の料金込みで、追加請求はございません。</p>
          <hr class="sec-rule" />
        </div>

        <div class="breed-price__grid">
          {rows.map((row) => (
            <div class="breed-price__card" data-reveal>
              <p class="breed-price__guide">{row.guide}</p>
              <p class="breed-price__types">{row.label}</p>
              <dl class="breed-price__plans">
                <div class="breed-price__row">
                  <dt class="breed-price__plan">{planColumns[0].name}<span class="breed-price__plan-sub">{planColumns[0].sub}</span></dt>
                  <dd class="breed-price__value">{row.joint === null ? '対応不可' : yen(row.joint)}</dd>
                </div>
                <div class="breed-price__row">
                  <dt class="breed-price__plan">{planColumns[1].name}<span class="breed-price__plan-sub">{planColumns[1].sub}</span></dt>
                  <dd class="breed-price__value">{yen(row.private)}</dd>
                </div>
                <div class="breed-price__row">
                  <dt class="breed-price__plan">{planColumns[2].name}<span class="breed-price__plan-sub">{planColumns[2].sub}</span></dt>
                  <dd class="breed-price__value">{yen(row.attended)}</dd>
                </div>
                <div class="breed-price__row breed-price__row--familia">
                  <dt class="breed-price__plan">{planColumns[3].name}<span class="breed-price__plan-sub">{planColumns[3].sub}</span></dt>
                  <dd class="breed-price__value">{yen(row.familia)}</dd>
                </div>
              </dl>
            </div>
          ))}
        </div>

        <p class="breed-price__note" data-reveal>
          体重が分からない場合も、お電話で丁寧にご案内します。全種類の料金は<a class="breed-price__link" href="/#price">料金表ページ</a>をご覧ください。
        </p>
      </div>
    </section>

    <section class="breed-points section">
      <div class="container">
        <div class="sec-head sec-head--center" data-reveal>
          <span class="sec-en">Care</span>
          <h2 class="sec-title">ファミリアが寄り添えること</h2>
          <hr class="sec-rule" />
        </div>
        <div class="breed-points__grid">
          {points.map((point, index) => (
            <article class="breed-point" data-reveal>
              <span class="breed-point__number">{String(index + 1).padStart(2, '0')}</span>
              <h3 class="breed-point__title">{point.title}</h3>
              <p class="breed-point__text">{point.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <Plans />
    <Flow />
    <Contact />
  </main>
  <Footer />
  <script>
    import '../scripts/navigation.js';
    import '../scripts/animations.js';
  </script>
</BaseLayout>
