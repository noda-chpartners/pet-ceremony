---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo02.png';
import Icon from './Icon.astro';
import { site } from '../data/site';
---

<footer class="site-footer">
  <div class="container site-footer__main">
    <div class="site-footer__brand">
      <a class="site-footer__logo-link" href="/#top" aria-label="ページ上部へ">
        <Image class="site-footer__logo" src={logo} alt="ペットセレモニーファミリア" width={300} />
      </a>
      <p class="site-footer__tagline">大切な家族とのお別れを、<br />心を込めてお手伝いいたします。</p>
      <div class="site-footer__socials" aria-label="公式SNS">
        <a class="site-footer__social" href={site.instagramUrl} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <Icon name="instagram" class="site-footer__social-icon" />
        </a>
        <a class="site-footer__social" href={site.youtubeUrl} target="_blank" rel="noopener noreferrer" aria-label="YouTube">
          <Icon name="youtube" class="site-footer__social-icon" />
        </a>
        <a class="site-footer__social" href={site.lineUrl} target="_blank" rel="noopener noreferrer" aria-label="LINE">
          <Icon name="line" class="site-footer__social-icon" />
        </a>
      </div>
    </div>

    <div class="site-footer__information">
      <h2 class="site-footer__heading">店舗情報</h2>
      <dl class="site-footer__details">
        <div class="site-footer__detail"><dt class="site-footer__term">名称</dt><dd class="site-footer__description">ペットセレモニーファミリア 相模原店</dd></div>
        <div class="site-footer__detail"><dt class="site-footer__term">業種</dt><dd class="site-footer__description">訪問ペット火葬・葬儀</dd></div>
        <div class="site-footer__detail"><dt class="site-footer__term">フリーダイヤル</dt><dd class="site-footer__description"><a class="site-footer__text-link" href={site.freedialTel}>{site.freedial}</a></dd></div>
        <div class="site-footer__detail"><dt class="site-footer__term">電話番号</dt><dd class="site-footer__description"><a class="site-footer__text-link" href="tel:0427034986">{site.tel}</a></dd></div>
        <div class="site-footer__detail"><dt class="site-footer__term">所在地</dt><dd class="site-footer__description">{site.address}</dd></div>
        <div class="site-footer__detail"><dt class="site-footer__term">営業時間</dt><dd class="site-footer__description">24時間365日対応（年中無休）</dd></div>
      </dl>
    </div>

    <nav class="site-footer__nav" aria-label="フッターメニュー">
      <h2 class="site-footer__heading">メニュー</h2>
      <a class="site-footer__nav-link" href="/#price">料金のご案内</a>
      <a class="site-footer__nav-link" href="/#reasons">選ばれる理由</a>
      <a class="site-footer__nav-link" href="/#plans">火葬プラン</a>
      <a class="site-footer__nav-link" href="/#voices">お客様の声</a>
      <a class="site-footer__nav-link" href="/#flow">お見送りの流れ</a>
      <a class="site-footer__nav-link" href="/#faq">よくあるご質問</a>
      <span class="site-footer__nav-group">種類別のご案内</span>
      <a class="site-footer__nav-link" href="/chihuahua/">チワワの火葬</a>
      <a class="site-footer__nav-link" href="/dachshund/">ダックスの火葬</a>
      <a class="site-footer__nav-link" href="/cat/">猫の火葬</a>
    </nav>
  </div>

  <div class="site-footer__bottom">
    <div class="container site-footer__bottom-inner">
      <p class="site-footer__copyright">© Pet Ceremony Familia</p>
      <a class="site-footer__corporate" href={site.corporateUrl} target="_blank" rel="noopener noreferrer">コーポレートサイト</a>
    </div>
  </div>
</footer>

<div class="float-cta" aria-label="お問い合わせ">
  <a class="float-cta__link float-cta__link--phone" href={site.freedialTel}><Icon name="phone" class="float-cta__icon" /><span class="float-cta__text">電話する</span></a>
  <a class="float-cta__link float-cta__link--line" href={site.lineUrl} target="_blank" rel="noopener noreferrer"><Icon name="line" class="float-cta__icon" /><span class="float-cta__text">LINE相談</span></a>
  <a class="float-cta__link float-cta__link--mail" href={site.mailUrl} target="_blank" rel="noopener noreferrer"><Icon name="mail" class="float-cta__icon" /><span class="float-cta__text">メール</span></a>
</div>
