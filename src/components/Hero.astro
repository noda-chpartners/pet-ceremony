---
import { Image } from 'astro:assets';
import heroImage from '../assets/images/lp-hero-serene.png';
import Icon from './Icon.astro';
import { site } from '../data/site';

const quickPrices = [
  { label: '猫', price: '13,200円〜' },
  { label: 'チワワなど小型犬', price: '13,200円〜' },
  { label: 'ミニチュアダックスなど', price: '15,400円〜' },
  { label: '柴犬など中型犬', price: '19,800円〜' },
  { label: 'ハムスターなど小動物', price: '6,600円〜' },
];
---

<section class="hero" id="top">
  <div class="hero__media" aria-hidden="true">
    <Image class="hero__image" src={heroImage} alt="" widths={[800, 1200, 1800]} sizes="100vw" loading="eager" />
    <div class="hero__veil"></div>
  </div>

  <div class="container hero__inner">
    <div class="hero__copy" data-hero-copy>
      <p class="hero__eyebrow"><span class="hero__eyebrow-line"></span>相模原市の訪問ペット火葬・葬儀</p>
      <h1 class="hero__title">
        「ありがとう」を、<br />いちばん安らげる場所で。
      </h1>
      <p class="hero__lead">
        ご自宅まで専門スタッフがお伺いし、住み慣れたお家から旅立ちのお手伝いをいたします。<br
          class="hero__lead-break"
        />深夜・早朝も、24時間365日受け付けております。
      </p>

      <ul class="hero__trust" aria-label="信頼の実績">
        <li class="hero__trust-item">
          <Icon name="star" class="hero__trust-star" />
          <span>Google口コミ評価 <strong>4.9</strong></span>
        </li>
        <li class="hero__trust-item"><span>神奈川県獣医師会報 掲載</span></li>
        <li class="hero__trust-item"><span>相模原市役所モニター 放映</span></li>
      </ul>

      <div class="hero__actions">
        <a class="hero__phone" href={site.freedialTel}>
          <Icon name="phone" class="hero__phone-icon" />
          <span class="hero__phone-copy">
            <span class="hero__phone-note">フリーダイヤル・24時間受付</span>
            <strong class="hero__phone-number">{site.freedial}</strong>
          </span>
        </a>
        <div class="hero__sub-actions">
          <a class="btn btn--gold hero__cta" href={site.lineUrl} target="_blank" rel="noopener noreferrer">
            <Icon name="line" class="btn__icon" />LINEで相談
          </a>
          <a class="btn btn--ghost hero__cta" href={site.mailUrl} target="_blank" rel="noopener noreferrer">
            <Icon name="mail" class="btn__icon" />メールで相談
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="hero__prices" data-hero-prices>
    <div class="container hero__prices-inner">
      <p class="hero__prices-title">火葬料金<span class="hero__prices-sub">税込・骨壺代込み</span></p>
      <ul class="hero__prices-list">
        {quickPrices.map((item) => (
          <li class="hero__prices-item">
            <span class="hero__prices-label">{item.label}</span>
            <span class="hero__prices-value">{item.price}</span>
          </li>
        ))}
      </ul>
      <a class="hero__prices-link" href="#price">料金表を見る<Icon name="arrow" class="hero__prices-arrow" /></a>
    </div>
  </div>
</section>
